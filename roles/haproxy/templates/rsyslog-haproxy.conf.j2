$AddUnixListenSocket /var/lib/haproxy/dev/log

# Collect log with syslog only if one of these conditions is true:
# 1. The log message was generated by a process named "haproxy"
# 2. The log was sent to the unix socket at /var/lib/haproxy/dev/log
:programname, startswith, "haproxy" {
  /var/log/haproxy/haproxy.log
  stop
}
