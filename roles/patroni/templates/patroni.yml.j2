---
scope: {{ patroni_scope }}
namespace: /db/
name: {{ inventory_hostname }}

restapi:
  listen: 0.0.0.0:{{ patroni_restapi_port }}
  connect_address: {{ ansible_host }}:{{ patroni_restapi_port }}

etcd3:
  hosts: {% for host in groups['etcd'] %}{{ hostvars[host]['ansible_host'] }}:{{ etcd_client_port }}{% if not loop.last %},{% endif %}{% endfor %}

  protocol: http

bootstrap:
  dcs:
    ttl: {{ patroni_bootstrap_dcs.ttl }}
    loop_wait: {{ patroni_bootstrap_dcs.loop_wait }}
    retry_timeout: {{ patroni_bootstrap_dcs.retry_timeout }}
    maximum_lag_on_failover: {{ patroni_bootstrap_dcs.maximum_lag_on_failover }}
    master_start_timeout: {{ patroni_bootstrap_dcs.master_start_timeout }}
    synchronous_mode: {{ patroni_bootstrap_dcs.synchronous_mode }}
    synchronous_mode_strict: {{ patroni_bootstrap_dcs.synchronous_mode_strict }}
    postgresql:
      use_pg_rewind: {{ patroni_bootstrap_dcs.postgresql.use_pg_rewind }}
      use_slots: {{ patroni_bootstrap_dcs.postgresql.use_slots }}
      parameters:
{% for key, value in patroni_bootstrap_dcs.postgresql.parameters.items() %}
        {{ key }}: {{ value }}
{% endfor %}

  initdb:
    - encoding: UTF8
    - data-checksums
    - locale: en_US.UTF-8

  pg_hba:
    - host replication {{ pg_replication_user }} 0.0.0.0/0 md5
    - host all all 0.0.0.0/0 md5
    - local all all peer

  users:
    {{ pg_superuser }}:
      password: {{ pg_superuser_password }}
      options:
        - createrole
        - createdb
        - superuser
    {{ pg_replication_user }}:
      password: {{ pg_replication_password }}
      options:
        - replication

postgresql:
  listen: 0.0.0.0:5432
  connect_address: {{ ansible_host }}:5432
  data_dir: {{ postgresql_data_dir }}
  bin_dir: {{ postgresql_bin_dir }}
  config_dir: {{ postgresql_data_dir }}

  authentication:
    replication:
      username: {{ pg_replication_user }}
      password: {{ pg_replication_password }}
    superuser:
      username: {{ pg_superuser }}
      password: {{ pg_superuser_password }}
    rewind:
      username: {{ pg_superuser }}
      password: {{ pg_superuser_password }}

  parameters:
    unix_socket_directories: '/var/run/postgresql'
    log_destination: 'stderr'
    logging_collector: 'on'
    log_directory: '/var/log/postgresql'
    log_filename: 'postgresql-%Y-%m-%d_%H%M%S.log'
    log_rotation_age: '1d'
    log_rotation_size: '100MB'
    log_min_duration_statement: 500
    log_checkpoints: 'on'
    log_connections: 'on'
    log_disconnections: 'on'
    log_lock_waits: 'on'
    log_temp_files: 0
    log_autovacuum_min_duration: 0
    log_line_prefix: '%m [%p] %q%u@%d '

  create_replica_methods:
    - basebackup

  basebackup:
    checkpoint: fast
    max-rate: 100M
    verbose:

tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
  nosync: false

watchdog:
  mode: off
  device: /dev/watchdog
  safety_margin: 5

log:
  level: INFO
  dir: /var/log/patroni
  file_num: 10
  file_size: 26214400  # 25 MB
